# ─── Database (PostgreSQL via Prisma) ────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# For Supabase, use the connection string from your Supabase dashboard
DATABASE_URL="postgresql://db_user:db_password@host:port/database"

# ─── JWT Secrets (generate secure random strings for production) ─────────────
# Generate these using: openssl rand -base64 32
JWT_ACCESS_SECRET=your_access_secret_here
JWT_REFRESH_SECRET=your_refresh_secret_here

# ─── Cloudinary (optional — image uploads) ───────────────────────────────────
# Get from https://cloudinary.com → Dashboard
# Leave as default if not using image uploads
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name_here

# ─── Application Environment ─────────────────────────────────────────────────
NODE_ENV=production

# ─── Application Port (Vercel sets this automatically) ───────────────────────
# PORT=3000  # Only needed for local development, Vercel sets this automatically