# ─── Database (PostgreSQL via Prisma) ────────────────────────────────────────
# For Vercel deployment, use your Supabase connection string
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL="postgresql://postgres:your_password@db.your_project.supabase.co:5432/postgres"

# ─── JWT Secrets (CRITICAL: Generate secure secrets for production) ─────────────
# Generate these using: openssl rand -base64 32
# These MUST be at least 32 characters long
JWT_ACCESS_SECRET=your_secure_access_secret_minimum_32_characters
JWT_REFRESH_SECRET=your_secure_refresh_secret_minimum_32_characters

# ─── Cloudinary (optional — image uploads) ───────────────────────────────────
# Get from https://cloudinary.com → Dashboard
# Leave as default if not using image uploads
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name_here

# ─── Application Environment ─────────────────────────────────────────────────
NODE_ENV=production

# ─── Vercel Specific ───────────────────────────────────────────────────────
# Vercel automatically sets PORT, don't override it