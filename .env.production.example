# ─── Vercel Production Environment Variables ───────────────────────────────────
# Copy these variables to your Vercel project settings:
# Vercel Dashboard → Project → Settings → Environment Variables

# ─── Database (PostgreSQL via Prisma) ────────────────────────────────────────
# For Vercel Postgres: Use the connection string from Vercel Dashboard
# For external PostgreSQL: Use your connection string
DATABASE_URL=postgresql://user:password@host:port/database

# ─── JWT Secrets (CRITICAL - Generate secure random strings) ──────────────────
# Generate using: openssl rand -base64 32
# These MUST be set in production for authentication to work
JWT_ACCESS_SECRET=your_secure_access_secret_min_32_chars
JWT_REFRESH_SECRET=your_secure_refresh_secret_min_32_chars

# ─── Cloudinary (optional — image uploads) ───────────────────────────────────
# Get from https://cloudinary.com → Dashboard
# Optional: Leave empty if not using image uploads
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# ─── Application Environment ─────────────────────────────────────────────────
NODE_ENV=production